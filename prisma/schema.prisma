generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id                    String                 @id @default(uuid())
  nomeFantasia          String
  razaoSocial           String
  cnpj                  String
  email                 String
  telefone              String
  endereco              String
  bairro                String?
  cidade                String?
  estado                String?
  cep                   String?
  logomarcaUrl          String?
  assinaturaUrl         String?                // Assinatura/Carimbo Digital do Representante
  
  // Controle de Teste Grátis (Trial) e Assinatura SaaS
  statusAssinatura      String?                @default("TRIAL") // TRIAL, ATIVO, EXPIRADO, BLOQUEADO
  dataInicioTrial       DateTime?              @default(now())
  dataFimTrial          DateTime?
  dataFimAcesso         DateTime?
  planoAtual            String?                @default("TRIAL") // TRIAL, MENSAL, TRIMESTRAL, SEMESTRAL, ANUAL
  ultimoAvisoWhatsAppEm DateTime?

  // Dados de Recebimento PIX da Empresa (para cobrança de locatários)
  chavePix              String?
  tipoChavePix          String?                @default("CNPJ")
  nomeBeneficiarioPix   String?
  cidadePix             String?

  // Identificador de Empresa MESTRE (Acesso Vitalício e Gestora do SaaS)
  isMestre              Boolean?               @default(false)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  usuarios              Usuario[]
  locatarios            Locatario[]
  fornecedores          Fornecedor[]
  locais                Local[]
  flats                 Flat[]
  modelosContrato       ModeloContrato[]
  contratos             Contrato[]
  contasReceber         ContaReceber[]
  contasPagar           ContaPagar[]
  vistoriasChecklist    VistoriaChecklist[]
  formasPagamento       FormaPagamento[]
  configuracaoParametros ConfiguracaoParametros?
}

model ConfiguracaoSaaS {
  id                      String   @id @default("saas-global-config")
  diasTrialPadrao         Int      @default(7)
  chavePix                String?  @default("contato@pajotech.com.br")
  tipoChavePix            String?  @default("EMAIL")
  nomeBeneficiarioPix     String?  @default("Pajo Tecnologia")
  cidadePix               String?  @default("Recife")
  valorMensal             Float    @default(97.0)
  valorTrimestral         Float    @default(260.0)
  valorSemestral          Float    @default(490.0)
  valorAnual              Float    @default(890.0)
  diasAvisoAntesExpirar   Int      @default(3)
  telefoneSuporteWhatsApp String?  @default("(87) 99654-0551")
  mensagemAvisoWhatsApp   String?  @default("Olá, {{nome}}! Informamos que o período de teste do Gestão de Flats para a empresa {{empresa}} irá expirar em {{dias_restantes}} dia(s) (Data: {{data_expiracao}}). Para continuar utilizando todos os recursos sem interrupções, renove seu acesso no link: {{link_renovacao}}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model ConfiguracaoParametros {
  id                String   @id @default(uuid())
  empresaId         String   @unique
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  // Evolution API (WhatsApp)
  evolutionApiUrl   String?
  evolutionApiKey   String?
  evolutionInstance String?
  statusConexao     String   @default("DESCONECTADO")

  // SMTP Gmail / Email Server
  smtpHost          String?  @default("smtp.gmail.com")
  smtpPort          Int?     @default(465)
  smtpUser          String?
  smtpPass          String?
  smtpSecure        Boolean  @default(true)
  smtpFromEmail     String?

  // Banco Inter (Boleto com Pix / Bolepix API v3)
  bancoInterClientId      String?
  bancoInterClientSecret  String?
  bancoInterCertCrt       String?   // Certificado .crt ou PEM Base64
  bancoInterCertKey       String?   // Chave privada .key ou PEM Base64
  bancoInterContaCorrente String?
  bancoInterAmbiente      String?   @default("PRODUCAO") // PRODUCAO ou SANDBOX
  bancoInterChavePix      String?
  bancoInterAtivo         Boolean   @default(false)
  bancoInterWebhookUrl    String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Usuario {
  id                        String    @id @default(uuid())
  empresaId                 String
  empresa                   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome                      String
  email                     String    @unique
  senhaHash                 String
  cargo                     String    @default("ADMIN") // ADMIN, OPERADOR, FINANCEIRO
  status                    String    @default("ATIVO") // ATIVO, INATIVO
  tokenRecuperacaoSenha     String?
  validadeTokenRecuperacao  DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model Locatario {
  id             String         @id @default(uuid())
  empresaId      String
  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome           String
  cpf            String
  rg             String?
  dataNascimento String?
  email          String?
  telefone       String
  endereco       String?
  estadoCivil    String?
  profissao      String?
  nacionalidade  String?        @default("Brasileiro(a)")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  contratos          Contrato[]
  contasReceber      ContaReceber[]
  vistoriasChecklist VistoriaChecklist[]
}

model Fornecedor {
  id          String       @id @default(uuid())
  empresaId   String
  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  razaoSocial String
  cnpj        String
  endereco    String?
  cep         String?
  telefone    String?
  email       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  contasPagar ContaPagar[]
}

model Local {
  id          String       @id @default(uuid())
  empresaId   String
  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome        String
  endereco    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  flats       Flat[]
  contasPagar ContaPagar[]
}

model Flat {
  id          String              @id @default(uuid())
  empresaId   String
  empresa     Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  localId     String
  local       Local               @relation(fields: [localId], references: [id], onDelete: Cascade)
  numero      String
  status      String              @default("DISPONIVEL") // DISPONIVEL, OCUPADO, MANUTENCAO
  descricao   String?
  valorPadrao Float               @default(0)
  fotosUrl    String?             // JSON String array de URLs das fotos do flat
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  contratos          Contrato[]
  contasPagar        ContaPagar[]
  vistoriasChecklist VistoriaChecklist[]
}

model ModeloContrato {
  id           String     @id @default(uuid())
  empresaId    String
  empresa      Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  titulo       String
  conteudoHtml String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  contratos    Contrato[]
}

model Contrato {
  id                      String          @id @default(uuid())
  empresaId               String
  empresa                 Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  locatarioId             String
  locatario               Locatario       @relation(fields: [locatarioId], references: [id], onDelete: Cascade)
  flatId                  String
  flat                    Flat            @relation(fields: [flatId], references: [id], onDelete: Cascade)
  modeloContratoId        String?
  modeloContrato          ModeloContrato? @relation(fields: [modeloContratoId], references: [id], onDelete: SetNull)
  dataEmissao             DateTime
  tipoValidade            String          @default("MESES") // MESES, DIAS
  validadeMeses           Int
  validadeDias            Int?
  dataFinal               DateTime
  valorMensal             Float

  // Novos Campos de Condições Financeiras e Regras do Contrato
  diaVencimento           Int?            @default(5)
  formaPagamento          String?         @default("PIX")
  bancoNome               String?
  bancoDadosConta         String?
  multaAtrasoPercentual   Float?          @default(2.0)
  jurosAtrasoPercentual   Float?          @default(1.0)
  valorCaucao             Float?          @default(0.0)
  caucaoParcelas          Int?            @default(0)
  multaRescisaoMeses      Int?            @default(3)

  status                  String          @default("ATIVO") // ATIVO, FINALIZADO, CANCELADO
  fotosAnexadasUrl        String?         // JSON String array das fotos anexadas ao contrato
  anexoChecklistEntrada   String?         // JSON String da Vistoria/Checklist de Entrada
  anexoChecklistSaida     String?         // JSON String da Vistoria/Checklist de Saída
  
  tokenAssinatura         String?         @unique
  statusAssinatura        String          @default("PENDENTE") // PENDENTE, ASSINADO
  assinaturaLocatarioUrl String?         // Base64 ou URL da assinatura desenhada pelo locatário
  dataAssinaturaLocatario DateTime?
  ipAssinaturaLocatario   String?

  // Auditoria Blockchain (OpenTimestamps / Bitcoin)
  documentoHashSha256     String?         // Hash SHA-256 (64 hex characters) do PDF assinado
  otsProofBase64          String?         // Arquivo .ots serializado em Base64
  blockchainProtocol      String?         @default("OpenTimestamps / Bitcoin Blockchain")
  blockchainStatus        String?         @default("STAMPED")
  dataHashGerado          DateTime?       // Timestamp da ancoragem na blockchain

  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  contasReceber           ContaReceber[]
  vistoriasChecklist      VistoriaChecklist[]
}

model VistoriaChecklist {
  id                      String      @id @default(uuid())
  empresaId               String
  empresa                 Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contratoId              String?
  contrato                Contrato?   @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  flatId                  String
  flat                    Flat        @relation(fields: [flatId], references: [id], onDelete: Cascade)
  locatarioId             String?
  locatario               Locatario?  @relation(fields: [locatarioId], references: [id], onDelete: SetNull)
  
  tipoVistoria            String @default("ENTRADA") // ENTRADA, SAIDA
  responsavelVistoria     String
  dataVistoria            DateTime    @default(now())
  itensJson               String      // JSON dos itens vistoriados (categoria, item, status, obs)
  
  tokenAssinatura         String      @unique
  statusAssinatura        String      @default("PENDENTE") // PENDENTE, ASSINADO
  laudoImpressoUrl        String?     // URL do PDF ou Foto do Laudo impresso/assinado manualmente
  assinaturaLocatarioUrl String?     // Base64 da assinatura
  dataAssinaturaLocatario DateTime?
  ipAssinaturaLocatario   String?

  // Auditoria Blockchain (OpenTimestamps / Bitcoin)
  documentoHashSha256     String?         // Hash SHA-256 (64 hex characters) do PDF assinado
  otsProofBase64          String?         // Arquivo .ots serializado em Base64
  blockchainProtocol      String?         @default("OpenTimestamps / Bitcoin Blockchain")
  blockchainStatus        String?         @default("STAMPED")
  dataHashGerado          DateTime?       // Timestamp da ancoragem na blockchain

  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
}

model ContaReceber {
  id             String    @id @default(uuid())
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contratoId     String?
  contrato       Contrato? @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  locatarioId    String
  locatario      Locatario @relation(fields: [locatarioId], references: [id], onDelete: Cascade)
  mesReferencia  String    // Ex: "2026-01"
  numeroParcela  Int       @default(1)
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  formaPagamento String?   // PIX, DINHEIRO, CARTAO, BOLETO
  valorPago      Float?
  status         String    @default("PENDENTE") // PENDENTE, PAGO, ATRASADO
  observacao     String?

  // Integração Banco Inter (Bolepix)
  bancoInterCodigoSolicitacao String?
  bancoInterNossoNumero       String?
  bancoInterLinhaDigitavel    String?
  bancoInterCodigoBarras      String?
  bancoInterPixCopiaECola     String?
  bancoInterPixQrCode         String?
  bancoInterPdfUrl            String?
  bancoInterStatus            String?   // EMABERTO, RECEBIDO, CANCELADO, EXPIRADO
  bancoInterDataEmissao       DateTime?
  bancoInterMensagemErro      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ContaPagar {
  id             String      @id @default(uuid())
  empresaId      String
  empresa        Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fornecedorId   String?
  fornecedor     Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  localId        String?
  local          Local?      @relation(fields: [localId], references: [id], onDelete: SetNull)
  flatId         String?
  flat           Flat?       @relation(fields: [flatId], references: [id], onDelete: SetNull)
  dataCompra     DateTime
  dataVencimento DateTime
  dataPagamento  DateTime?
  descricao      String
  valor          Float
  status         String      @default("PENDENTE") // PENDENTE, PAGO, ATRASADO
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model FormaPagamento {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

