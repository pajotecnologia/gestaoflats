generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id                    String                 @id @default(uuid())
  nomeFantasia          String
  razaoSocial           String
  cnpj                  String
  email                 String
  telefone              String
  endereco              String
  bairro                String?
  cidade                String?
  estado                String?
  cep                   String?
  logomarcaUrl          String?
  assinaturaUrl         String?                // Assinatura/Carimbo Digital do Representante
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  usuarios              Usuario[]
  locatarios            Locatario[]
  fornecedores          Fornecedor[]
  locais                Local[]
  flats                 Flat[]
  modelosContrato       ModeloContrato[]
  contratos             Contrato[]
  contasReceber         ContaReceber[]
  contasPagar           ContaPagar[]
  vistoriasChecklist    VistoriaChecklist[]
  modelosChecklist      ChecklistModelo[]
  formasPagamento       FormaPagamento[]
  configuracaoParametros ConfiguracaoParametros?
  reservas              Reserva[]
  eventosContrato       ContratoEvento[]
  eventosFinanceiros    FinanceiroEvento[]
  documentos            ClienteDocumento[]
  ordensServico         OrdemServico[]
}

model ConfiguracaoParametros {
  id                String   @id @default(uuid())
  empresaId         String   @unique
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  // Evolution API (WhatsApp)
  evolutionApiUrl   String?
  evolutionApiKey   String?
  evolutionInstance String?
  statusConexao     String   @default("DESCONECTADO")

  // SMTP Gmail / Email Server
  smtpHost          String?  @default("smtp.gmail.com")
  smtpPort          Int?     @default(465)
  smtpUser          String?
  smtpPass          String?
  smtpSecure        Boolean  @default(true)
  smtpFromEmail     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Usuario {
  id                        String    @id @default(uuid())
  empresaId                 String
  empresa                   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome                      String
  email                     String    @unique
  senhaHash                 String
  cargo                     String    @default("ADMIN") // ADMIN, OPERADOR, FINANCEIRO
  status                    String    @default("ATIVO") // ATIVO, INATIVO
  tokenRecuperacaoSenha     String?
  validadeTokenRecuperacao  DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model Locatario {
  id             String         @id @default(uuid())
  empresaId      String
  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome           String
  cpf            String
  rg             String?
  dataNascimento String?
  email          String?
  telefone       String
  endereco       String?
  estadoCivil    String?
  profissao      String?
  nacionalidade  String?        @default("Brasileiro(a)")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  contratos          Contrato[]
  contasReceber      ContaReceber[]
  vistoriasChecklist VistoriaChecklist[]
  reservas            Reserva[]
  documentos           ClienteDocumento[]
  ordensServico        OrdemServico[]
}

model Fornecedor {
  id          String       @id @default(uuid())
  empresaId   String
  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  razaoSocial String
  cnpj        String
  endereco    String?
  cep         String?
  telefone    String?
  email       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  contasPagar ContaPagar[]
}

model Local {
  id          String       @id @default(uuid())
  empresaId   String
  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome        String
  endereco    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  flats       Flat[]
  contasPagar ContaPagar[]
}

model Flat {
  id          String              @id @default(uuid())
  empresaId   String
  empresa     Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  localId     String
  local       Local               @relation(fields: [localId], references: [id], onDelete: Cascade)
  numero      String
  status      String              @default("DISPONIVEL") // DISPONIVEL, OCUPADO, MANUTENCAO
  descricao   String?
  valorPadrao Float               @default(0)
  fotosUrl    String?             // JSON String array de URLs das fotos do flat
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  contratos          Contrato[]
  contasPagar        ContaPagar[]
  vistoriasChecklist VistoriaChecklist[]
  reservas            Reserva[]
  ordensServico       OrdemServico[]
}

model ModeloContrato {
  id           String     @id @default(uuid())
  empresaId    String
  empresa      Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  titulo       String
  conteudoHtml String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  contratos    Contrato[]
}

model Contrato {
  id                      String          @id @default(uuid())
  empresaId               String
  empresa                 Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  locatarioId             String
  locatario               Locatario       @relation(fields: [locatarioId], references: [id], onDelete: Cascade)
  flatId                  String
  flat                    Flat            @relation(fields: [flatId], references: [id], onDelete: Cascade)
  modeloContratoId        String?
  modeloContrato          ModeloContrato? @relation(fields: [modeloContratoId], references: [id], onDelete: SetNull)
  dataEmissao             DateTime
  tipoValidade            String          @default("MESES") // MESES, DIAS
  validadeMeses           Int
  validadeDias            Int?
  dataFinal               DateTime
  valorMensal             Float

  // Novos Campos de Condições Financeiras e Regras do Contrato
  diaVencimento           Int?            @default(5)
  formaPagamento          String?         @default("PIX")
  bancoNome               String?
  bancoDadosConta         String?
  multaAtrasoPercentual   Float?          @default(2.0)
  jurosAtrasoPercentual   Float?          @default(1.0)
  valorCaucao             Float?          @default(0.0)
  caucaoParcelas          Int?            @default(0)
  multaRescisaoMeses      Int?            @default(3)

  status                  String          @default("ATIVO") // ATIVO, FINALIZADO, CANCELADO
  fotosAnexadasUrl        String?         // JSON String array das fotos anexadas ao contrato
  anexoChecklistEntrada   String?         // JSON String da Vistoria/Checklist de Entrada
  anexoChecklistSaida     String?         // JSON String da Vistoria/Checklist de Saída
  
  tokenAssinatura         String?         @unique
  statusAssinatura        String          @default("PENDENTE") // PENDENTE, ASSINADO
  assinaturaLocatarioUrl String?         // Base64 ou URL da assinatura desenhada pelo locatário
  dataAssinaturaLocatario DateTime?
  ipAssinaturaLocatario   String?

  // Auditoria Blockchain (OpenTimestamps / Bitcoin)
  documentoHashSha256     String?         // Hash SHA-256 (64 hex characters) do PDF assinado
  otsProofBase64          String?         // Arquivo .ots serializado em Base64
  blockchainProtocol      String?         @default("OpenTimestamps / Bitcoin Blockchain")
  blockchainStatus        String?         @default("STAMPED")
  dataHashGerado          DateTime?       // Timestamp da ancoragem na blockchain

  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  contasReceber           ContaReceber[]
  vistoriasChecklist      VistoriaChecklist[]
  reservas                Reserva[]
  eventos                 ContratoEvento[]
  documentos              ClienteDocumento[]
}

model ChecklistModelo {
  id            String   @id @default(uuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome          String
  descricao     String?
  itensJson     String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vistorias     VistoriaChecklist[]
  @@index([empresaId, ativo])
}

model VistoriaChecklist {
  id                      String      @id @default(uuid())
  empresaId               String
  empresa                 Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contratoId              String?
  contrato                Contrato?   @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  reservaId               String?
  reserva                 Reserva?    @relation(fields: [reservaId], references: [id], onDelete: SetNull)
  modeloId                String?
  modelo                  ChecklistModelo? @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  flatId                  String
  flat                    Flat        @relation(fields: [flatId], references: [id], onDelete: Cascade)
  locatarioId             String?
  locatario               Locatario?  @relation(fields: [locatarioId], references: [id], onDelete: SetNull)
  
  tipoVistoria            String      @default("ENTRADA") // ENTRADA, SAIDA
  responsavelVistoria     String
  dataVistoria            DateTime    @default(now())
  status                  String      @default("RASCUNHO") // RASCUNHO, CONCLUIDA, ASSINADA
  itensJson               String      // JSON: categoria, item, estado, observacao, avaria, fotoUrl
  fotosJson               String?     // JSON de fotos gerais da vistoria
  observacaoGeral         String?
  valorDanos              Float       @default(0)
  cobrancaDanosGerada     Boolean     @default(false)
  dataCobrancaDanos       DateTime?
  limpezaStatus           String      @default("PENDENTE") // PENDENTE, OK, NECESSITA_LIMPEZA
  manutencaoStatus        String      @default("PENDENTE") // PENDENTE, OK, NECESSITA_MANUTENCAO

  tokenAssinatura         String      @unique
  statusAssinatura        String      @default("PENDENTE") // PENDENTE, ASSINADO
  laudoImpressoUrl        String?
  assinaturaLocatarioUrl  String?
  dataAssinaturaLocatario DateTime?
  ipAssinaturaLocatario   String?

  documentoHashSha256     String?
  otsProofBase64          String?
  blockchainProtocol      String?     @default("OpenTimestamps / Bitcoin Blockchain")
  blockchainStatus        String?     @default("STAMPED")
  dataHashGerado          DateTime?

  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([empresaId, flatId, dataVistoria])
  @@index([reservaId])
  @@index([modeloId])
}

model ContaReceber {
  id             String    @id @default(uuid())
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contratoId     String?
  contrato       Contrato? @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  locatarioId    String
  locatario      Locatario @relation(fields: [locatarioId], references: [id], onDelete: Cascade)
  mesReferencia  String    // Ex: "2026-01"
  numeroParcela  Int       @default(1)
  valor          Float
  dataVencimento DateTime
  dataPagamento  DateTime?
  formaPagamento String?   // PIX, DINHEIRO, CARTAO, BOLETO
  valorPago      Float?
  status         String    @default("PENDENTE") // PENDENTE, PARCIAL, PAGO, ATRASADO
  observacao     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  eventosFinanceiros FinanceiroEvento[]
}

model ContaPagar {
  id             String      @id @default(uuid())
  empresaId      String
  empresa        Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fornecedorId   String?
  fornecedor     Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  localId        String?
  local          Local?      @relation(fields: [localId], references: [id], onDelete: SetNull)
  flatId         String?
  flat           Flat?       @relation(fields: [flatId], references: [id], onDelete: SetNull)
  dataCompra     DateTime
  dataVencimento DateTime
  dataPagamento  DateTime?
  descricao      String
  valor          Float
  valorPago      Float?     @default(0)
  formaPagamento String?
  status         String      @default("PENDENTE") // PENDENTE, PARCIAL, PAGO, ATRASADO
  observacao     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  eventosFinanceiros FinanceiroEvento[]
}

model FormaPagamento {
  id        String   @id @default(uuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Reserva {
  id                String    @id @default(uuid())
  empresaId         String
  empresa           Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  locatarioId       String
  locatario         Locatario @relation(fields: [locatarioId], references: [id], onDelete: Cascade)
  flatId            String
  flat              Flat      @relation(fields: [flatId], references: [id], onDelete: Cascade)
  contratoId        String?
  contrato          Contrato? @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  codigo            String    @unique
  dataEntrada       DateTime
  dataSaida         DateTime
  horaEntrada       String?
  horaSaida         String?
  quantidadePessoas Int       @default(1)
  valorDiaria       Float     @default(0)
  quantidadeDiarias Int       @default(1)
  desconto          Float     @default(0)
  taxas             Float     @default(0)
  caucao            Float     @default(0)
  valorTotal        Float     @default(0)
  valorRecebido     Float     @default(0)
  valorPendente     Float     @default(0)
  origem            String?
  observacao        String?
  status            String    @default("SOLICITADA") // SOLICITADA, PRE_RESERVA, AGUARDANDO_PAGAMENTO, CONFIRMADA, CHECK_IN, EM_ESTADIA, CHECK_OUT, FINALIZADA, CANCELADA
  dataCheckIn       DateTime?
  dataCheckOut      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([empresaId, dataEntrada, dataSaida])
  @@index([flatId, dataEntrada, dataSaida])
  @@index([locatarioId])

  vistorias VistoriaChecklist[]
}

model ContratoEvento {
  id         String   @id @default(uuid())
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tipo       String   // EMISSAO, ASSINATURA, RENOVACAO, REAJUSTE, RESCISAO, CANCELAMENTO, ALTERACAO
  descricao  String
  dadosJson  String?
  usuarioId  String?
  criadoEm   DateTime @default(now())

  @@index([empresaId, contratoId, criadoEm])
}


model ClienteDocumento {
  id            String     @id @default(uuid())
  empresaId     String
  empresa       Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  locatarioId   String
  locatario     Locatario  @relation(fields: [locatarioId], references: [id], onDelete: Cascade)
  contratoId    String?
  contrato      Contrato?  @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  tipo          String
  titulo        String
  descricao     String?
  arquivoUrl    String?
  mimeType      String?
  tamanhoBytes  Int?
  dataDocumento DateTime?
  validade      DateTime?
  status        String     @default("ATIVO")
  criadoEm      DateTime   @default(now())
  atualizadoEm  DateTime   @updatedAt

  @@index([empresaId, locatarioId])
  @@index([contratoId])
  @@index([validade])
}

model OrdemServico {
  id             String    @id @default(uuid())
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  locatarioId    String?
  locatario      Locatario? @relation(fields: [locatarioId], references: [id], onDelete: SetNull)
  flatId         String?
  flat           Flat?     @relation(fields: [flatId], references: [id], onDelete: SetNull)
  codigo         String    @unique
  titulo         String
  descricao      String?
  categoria      String    @default("MANUTENCAO")
  prioridade     String    @default("MEDIA")
  status         String    @default("ABERTA")
  responsavel    String?
  fornecedorNome String?
  valorEstimado  Float     @default(0)
  valorReal      Float     @default(0)
  dataAbertura   DateTime  @default(now())
  prazo          DateTime?
  dataConclusao  DateTime?
  observacao     String?
  fotosJson      String?
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  @@index([empresaId, status])
  @@index([empresaId, flatId])
  @@index([locatarioId])
  @@index([prazo])
}

model FinanceiroEvento {
  id            String        @id @default(uuid())
  empresaId     String
  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo          String        // LANCAMENTO, BAIXA, PARCIAL, ESTORNO, ALTERACAO
  contaReceberId String?
  contaReceber  ContaReceber? @relation(fields: [contaReceberId], references: [id], onDelete: Cascade)
  contaPagarId  String?
  contaPagar    ContaPagar?   @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  valor         Float?
  descricao     String
  dadosJson     String?
  usuarioId     String?
  criadoEm     DateTime      @default(now())

  @@index([empresaId, criadoEm])
  @@index([contaReceberId])
  @@index([contaPagarId])
}
